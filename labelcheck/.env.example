# Copy to .env and fill in. Never commit .env. All settings: see README "Settings".
# --- required ---
DOMAIN=labelcheck.example.com
LABELCHECK_PUBLIC_URL=https://labelcheck.example.com
POSTGRES_PASSWORD=change-me-long-random
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Encrypts 2FA secrets. Keep it safe: if it changes, users must set up 2FA again.
LABELCHECK_SECRET_KEY=change-me
# --- first admin (created once, on an empty database; also platform admin) ---
LABELCHECK_ORG_NAME=Your Company Pvt Ltd
LABELCHECK_ADMIN_EMAIL=admin@example.com
LABELCHECK_ADMIN_PASSWORD=Change-me-2026
# --- e-mail (password reset, invites, review alerts) ---
# Zoho ZeptoMail:    host=smtp.zeptomail.in (or .com / .eu), port=587, tls=starttls, user=emailapikey
# Amazon SES:        host=email-smtp.ap-south-1.amazonaws.com, port=587, tls=starttls
# Gmail (App Pwd):   host=smtp.gmail.com, port=587, tls=starttls
# Brevo:             host=smtp-relay.brevo.com, port=587, tls=starttls
LABELCHECK_SMTP_HOST=
LABELCHECK_SMTP_PORT=587
LABELCHECK_SMTP_USER=
LABELCHECK_SMTP_PASSWORD=
LABELCHECK_SMTP_TLS=starttls
LABELCHECK_MAIL_FROM=LabelCheck <no-reply@example.com>
# --- payments (Razorpay for Paid Plans & Scan Packs) ---
# Leave empty for simulated sandbox payments in development.
LABELCHECK_RAZORPAY_KEY_ID=
LABELCHECK_RAZORPAY_KEY_SECRET=
LABELCHECK_RAZORPAY_WEBHOOK_SECRET=
# --- optional ---
LABELCHECK_WORKERS=2
LABELCHECK_FOUR_EYES=1
# LABELCHECK_STORAGE=s3
# LABELCHECK_S3_BUCKET=my-labelcheck-files
# AWS_REGION=ap-south-1
# LABELCHECK_METRICS_TOKEN=
